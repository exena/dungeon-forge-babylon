{
  "name": "dungeon-forge-babylon",
  "version": "1.0.0",
  "private": true,
  "description": "An independent Babylon.js port of Dungeon Forge by Majid Manzarpour",
  "type": "module",
  "author": "Majid Manzarpour (https://x.com/majidmanzarpour)",
  "repository": { "type": "git", "url": "https://github.com/exena/dungeon-forge-babylon.git" },
  "engines": { "node": ">=22.12.0" },
  "license": "MIT",
  "keywords": [
    "babylon.js",
    "procedural-generation",
    "procgen",
    "dungeon-generator",
    "delaunay",
    "roguelike",
    "webgl",
    "gamedev"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*"
  },
  "dependencies": {
    "@babylonjs/core": "9.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.0"
  }
}
